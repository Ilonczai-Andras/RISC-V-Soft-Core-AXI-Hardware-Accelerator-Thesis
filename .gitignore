# Vivado - Auto-generated large directories
vivado_project/*/.Xil/
vivado_project/*/*.cache/
vivado_project/*/*.hw/
vivado_project/*/*.ip_user_files/
vivado_project/*/*.runs/
vivado_project/*/*.sim/
vivado_project/*/*.gen/

# Vivado log and journal files
*.log
*.jou
vivado_*.str
vivado_*.zip
hs_err_pid*.dmp

# Vivado generated binary artifacts and checkpoints
*.dcp
*.bit
*.bin

# RISC-V software build artifacts
software/*/*.o
software/*/*.elf
software/*/*.bin
software/*/*.hex
software/*/*.coe
software/*/*.map

# Python & System files
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db